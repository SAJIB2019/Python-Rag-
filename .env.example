NODE_ENV=development
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:55433/rag_fastapi
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_TLS=false
REDIS_DATABASE=0
QUEUE_NAME=rag-fastapi:documents
API_KEY=local-development-key
METRICS_API_KEY=local-metrics-key
CORS_ORIGIN=*
REQUEST_BODY_LIMIT_BYTES=1048576
UPLOAD_MAX_FILE_BYTES=10485760
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=60
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_TIMEOUT_MS=30000
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
LLM_MODEL=gpt-4.1-mini
SEARCH_BACKEND=postgres
QDRANT_URL=http://localhost:6334
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_fastapi_chunks
ELASTICSEARCH_URL=http://localhost:9201
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=rag-fastapi-chunks
OTEL_ENABLED=false
OTEL_SERVICE_NAME=rag-from-zero-fastapi
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
